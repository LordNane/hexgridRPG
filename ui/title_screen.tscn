[gd_scene format=3]

[ext_resource type="Script" path="res://ui/title_screen.gd" id="1_title"]
[ext_resource type="Theme" path="res://ui/theme/pixel_theme.tres" id="2_theme"]

[node name="TitleScreen" type="CanvasLayer"]
script = ExtResource("1_title")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Menu" type="VBoxContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -60.0
offset_top = -64.0
offset_right = 60.0
offset_bottom = 64.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Title" type="Label" parent="Root/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Hex RPG"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Root/Menu"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2

[node name="NewGame" type="Button" parent="Root/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "New Game"

[node name="Continue" type="Button" parent="Root/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "Continue"

[node name="Quit" type="Button" parent="Root/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"
